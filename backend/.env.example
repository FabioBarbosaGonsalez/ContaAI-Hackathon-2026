# Copie para backend/.env (que fica fora do git) e preencha só o que precisar.
# Nunca coloque chave de API neste arquivo de exemplo, em código, issue, PR ou captura de tela.

# mock (padrão) ou real (motores de pé: docker compose up -d)
CONTAAI_MODO=mock

# Agente (ADR 0006). "roteiro" funciona sem IA e sem custo.
# Para ligar uma IA: escrever o adaptador em app/agente/provedores/ e registrar em app/agente/provedor.py.
# Antes de usar a chave, confira na página oficial do provedor o preço, os limites e o uso dos dados.
CONTAAI_LLM_PROVEDOR=roteiro
CONTAAI_LLM_MODELO=
CONTAAI_LLM_CHAVE=
CONTAAI_LLM_URL=

# Demo pública: com o token definido, POST /chat exige o header X-ContaAI-Token.
CONTAAI_TOKEN_DEMO=
CONTAAI_LIMITE_CHAT_POR_MINUTO=10
CONTAAI_LIMITE_GERAL_POR_MINUTO=120
CONTAAI_LIMITE_BUSCA_POR_MINUTO=20
