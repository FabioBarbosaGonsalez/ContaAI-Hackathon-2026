# Regras de instalação do frontend (docs/seguranca.md, item 8 das regras da interface).

# Só instala versões publicadas há mais de 7 dias, inclusive as dependências transitivas.
# Uma versão comprometida costuma ser retirada do registro em poucas horas ou dias.
min-release-age=7

# Grava a versão exata no package.json (sem ^ nem ~); o package-lock.json trava o resto.
save-exact=true

# Não roda scripts de instalação (preinstall/install/postinstall) dos pacotes de terceiros.
ignore-scripts=true

# Falha se a versão do Node não atender ao campo engines do package.json.
engine-strict=true

# Só o registro público e gratuito do npm.
registry=https://registry.npmjs.org/

# Sem mensagens de financiamento.
fund=false
